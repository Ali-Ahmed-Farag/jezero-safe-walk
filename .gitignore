# ===== Large data: never commit raw data, keep links in docs/sources.md =====
data/raw/*
!data/raw/.gitkeep
*.tif
*.tiff
*.img
*.zip

# Small processed rasters are allowed (keep each under ~50 MB)
# This line must stay AFTER the *.tif / *.tiff lines above
!data/processed/*.tif
!data/processed/*.tiff

# ===== Python =====
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/
tempCodeRunnerFile.py

# Virtual environments
.venv
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# ===== JavaScript / Web =====
node_modules/
.parcel-cache/
.next/
.vite/
npm-debug.log*
yarn-error.log*

# ===== Secrets =====
.env
.envrc
.streamlit/secrets.toml

# ===== Editors and OS files =====
.DS_Store
Thumbs.db
.idea/
*.swp
